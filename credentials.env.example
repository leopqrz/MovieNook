# Local-only credentials. bootstrap.sh copies this to private/credentials.env.
# Never commit private/credentials.env or put real values in this example.

# Plex signs in through its own secure browser page. MovieNook records the account
# identity after approval, but never requests or stores a Plex/Google password.
PLEX_AUTH_METHOD=browser_oauth
PLEX_USERNAME=
PLEX_EMAIL=

# Seerr uses Plex sign-in; it has no separate account password.

# VPN selection and optional account reference. The native VPN app securely
# retains its OAuth/login session. VPN_ACCOUNT_PASSWORD is never read by
# MovieNook; leave it blank for Google/Apple SSO and never store an SSO password.
VPN_PROVIDER=
VPN_AUTH_METHOD=
VPN_ACCOUNT_EMAIL=
VPN_ACCOUNT_USERNAME=
VPN_ACCOUNT_PASSWORD=
VPN_SUBSCRIPTION=
VPN_CREDENTIAL_STORAGE=native_app_secure_storage

# Local application API keys. MovieNook can preserve these across a clean
# first-run test. They are generated locally and are not account passwords.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
SEERR_API_KEY=
SABNZBD_API_KEY=
SABNZBD_USERNAME=
SABNZBD_PASSWORD=

# qBittorrent Web UI
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# Usenet provider (leave blank when not using Usenet)
USENET_PROVIDER_NAME=
USENET_HOST=
USENET_PORT=563
USENET_USE_SSL=true
USENET_USERNAME=
USENET_PASSWORD=

# API-key indexers do not need a separate username or password here.
INDEXER_1_NAME=
INDEXER_1_URL=
INDEXER_1_API_KEY=
INDEXER_1_USERNAME=
INDEXER_1_PASSWORD=

INDEXER_2_NAME=
INDEXER_2_URL=
INDEXER_2_API_KEY=
INDEXER_2_USERNAME=
INDEXER_2_PASSWORD=
