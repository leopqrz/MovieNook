# Copy to .env and replace only values marked CHANGE_ME.
# Use an absolute path. It may be this project's path or an external media drive.
MOVIENOOK_ROOT="/absolute/path/to/MovieNook"

# Use your host user's numeric IDs. bootstrap.sh fills these on macOS/Linux.
# On Windows Docker Desktop, 1000 is fine.
PUID=1000
PGID=1000
TZ=America/Regina

# MovieNook obtains the short-lived claim securely during browser approval.
PLEX_CLAIM=

# Change published ports only if the host has a conflict.
PLEX_PORT=32400
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENT_PORT=6881
SABNZBD_PORT=8085
SEERR_PORT=5055

# Suppress duplicate Plex/Seerr tabs when startup is triggered twice close together.
MOVIENOOK_BROWSER_DEBOUNCE_SECONDS=120
